# Copy to configs/cifar10_posthoc_weight_paths.env and replace these paths after
# the five CE ensemble members finish. Use checkpoint_best.pt for BEST paths and
# checkpoint_last.pt for LAST paths from the same five checkpoint directories.
#
# Example:
# CIFAR10_BEST_WEIGHT_PATHS=checkpoints/run_seed0/checkpoint_best.pt,checkpoints/run_seed1/checkpoint_best.pt
# CIFAR10_LAST_WEIGHT_PATHS=checkpoints/run_seed0/checkpoint_last.pt,checkpoints/run_seed1/checkpoint_last.pt

CIFAR10_BEST_WEIGHT_PATHS=
CIFAR10_LAST_WEIGHT_PATHS=
